
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================
// CONFIGURACIÓN GENERAL
// =====================================

model SiteConfig {
  id           Int     @id @default(1)
  name         String
  slogan       String?
  description  String?
  logoUrl      String?
  heroImageUrl String?
  whatsapp     String?
  phone        String?
  email        String?
  address      String?
  mapsUrl      String?
  instagramUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================
// SERVICIOS
// =====================================

model Service {
  id          String  @id @default(cuid())
  title       String
  description String?
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================
// PROFESIONALES DE LA PÁGINA PÚBLICA
// =====================================

model Professional {
  id          String   @id @default(cuid())
  name        String
  license     String
  specialties String[]
  imageUrl    String?
  active      Boolean  @default(true)

  branches ProfessionalBranch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

// =====================================
// SUCURSALES
// =====================================

model Branch {
  id           String   @id @default(cuid())
  name         String
  address      String
  hours        String[]
  mapsUrl      String?
  whatsapp     String?
  instagramUrl String?

  professionals ProfessionalBranch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================
// RELACIÓN PROFESIONALES - SUCURSALES
// =====================================

model ProfessionalBranch {
  professionalId String
  branchId       String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([professionalId, branchId])
  @@index([branchId])
}

// =====================================
// OBRAS SOCIALES
// =====================================

model InsuranceProvider {
  id      String  @id @default(cuid())
  name    String  @unique
  logoUrl String?
  active  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================
// AUTENTICACIÓN DEL ADMINISTRADOR
// =====================================

// Conservamos temporalmente los valores anteriores
// hasta limpiar las cuentas antiguas de Neon.
enum UserRole {
  ADMIN
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  role            UserRole
  active          Boolean  @default(true)

  passwordHash    String?
  emailVerifiedAt DateTime?
  sessionVersion  Int      @default(0)

  passwordResets PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================
// RECUPERACIÓN DE CONTRASEÑA
// =====================================

model PasswordResetToken {
  id        String    @id @default(cuid())

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}
