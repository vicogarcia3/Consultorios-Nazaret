generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Plan {
  id       Int       @id @default(autoincrement())
  name     String
  price    Float
  description  String?
  benefits    String?

  patients Patient[]
  membershipRequests MembershipRequest[]
}

model Patient {
  id             Int       @id @default(autoincrement())
  name           String
  dni            String    @unique
  phone          String?

  planId         Int?
  plan           Plan?     @relation(fields: [planId], references: [id])

  joinDate       DateTime?
  nextCleaning   DateTime?

  paymentStatus  String    @default("al_dia")
  notes          String?

  turns          Turn[]

  payments Payment[]
  budgets Budget[]
  attachments Attachment[]
  medicalRecords MedicalRecord[]
  odontograms Odontogram[]

  createdAt      DateTime  @default(now())
}

model Doctor {
  id        Int      @id @default(autoincrement())
  name      String
  specialty String
  photo String?

  turns     Turn[]
}

model Turn {
  id        Int      @id @default(autoincrement())
  date      DateTime
  status    String   @default("pending")

  patientId Int
  doctorId  Int

  patient   Patient  @relation(fields: [patientId], references: [id])
  doctor    Doctor   @relation(fields: [doctorId], references: [id])

  createdAt DateTime @default(now())
}

  model Payment {
  id          Int       @id @default(autoincrement())

  patientId   Int
  patient     Patient   @relation(fields: [patientId], references: [id])

  amount      Float

  month       String

  dueDate     DateTime

  paidDate    DateTime?

  status      String    @default("pending")

  createdAt   DateTime  @default(now())
}

model Budget {
  id          Int      @id @default(autoincrement())

  patientId   Int
  patient     Patient  @relation(fields: [patientId], references: [id])

  treatments  String

  total       Float

  createdAt   DateTime @default(now())
}

model MedicalRecord {
  id          Int      @id @default(autoincrement())

  patientId   Int
  patient     Patient  @relation(fields: [patientId], references: [id])

  title       String
  diagnosis   String?
  treatment   String?
  notes       String?

  createdAt   DateTime @default(now())
}

model Attachment {
  id        String   @id @default(cuid())
  fileName  String
  fileUrl   String
  fileType  String   // pdf, image, etc.

  patientId Int
  patient   Patient  @relation(fields: [patientId], references: [id])

  createdAt DateTime @default(now())
}

model Odontogram {
  id        Int      @id @default(autoincrement())

  patientId Int
  patient   Patient  @relation(fields: [patientId], references: [id])

  tooth     Int
  status    String

  createdAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())

  name      String
  email     String   @unique
  password  String

  role      String   @default("professional")

  createdAt DateTime @default(now())
}

model MembershipRequest {
  id        Int      @id @default(autoincrement())

  firstName String
  lastName  String

  email     String
  phone     String

  planId    Int
  plan      Plan     @relation(fields: [planId], references: [id])

  status    String   @default("pending")

  createdAt DateTime @default(now())
}

model Config {
  id        Int    @id @default(autoincrement())
  whatsapp  String?
}